# Kept out of the Vercel deployment.
# (Secrets are safe regardless — .env is git-ignored and never committed.)

# local development & ops
scripts/
*.command

# local mirrors / runtime state (Supabase is the source of truth in the cloud)
data/
uploads/
logs/
public/

# docs & design sources (not needed to serve the site)
design-reference.png
README.txt

# never deploy keys
.env
.env.example
# local server must not reach Vercel: its presence flips the build
# into single-server mode (all traffic -> one crashing function)
local-server.js
