# Copy this file to `.env` and fill in your own values.
#
#   cp .env.example .env
#
# Find these in the Supabase dashboard → Project Settings → API.
# .env is git-ignored and must never be committed.

# Project reference (the short id in your Supabase URL)
SUPABASE_URL_REF=your-project-ref

# Secret / service-role key — SERVER SIDE ONLY, full database access.
# Never put this in any file that reaches a browser.
SUPABASE_SECRET_KEY=paste-your-service-role-key-here

# Anon key — safe to expose; this project sends every request through the
# Node server, so the browser never needs it.
SUPABASE_ANON_KEY=paste-your-anon-key-here

# Storage bucket for uploaded photos and video clips
SUPABASE_BUCKET=media